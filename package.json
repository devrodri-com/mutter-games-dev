{
  "name": "mutter-games",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/verify-edge-tooling.cjs build",
    "check:edge-tooling": "node scripts/verify-edge-tooling.cjs inventory",
    "test:edge-tooling": "node --test scripts/edge-tooling/tests/*.check.cjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "backend": "ts-node backend/server.cjs.ts",
    "dev:ts-node": "ts-node backend/server.cjs.ts",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:codegen": "playwright codegen http://localhost:5173",
    "test:catalog:run": "vitest run --fileParallelism=false",
    "test:catalog": "firebase emulators:exec --only firestore,auth --project demo-mutter-r1 --config firebase.catalog-emulators.json \"npm run test:catalog:run\"",
    "typecheck:api": "tsc --noEmit --skipLibCheck --moduleResolution NodeNext --target ES2022 --module NodeNext --esModuleInterop api/create-mp-preference.ts",
    "test:catalog:browser": "firebase emulators:exec --only firestore,auth --project demo-mutter-r1 --config firebase.catalog-emulators.json \"node scripts/run-catalog-browser.mjs\"",
    "check:checkout-packaging": "node scripts/verify-checkout-packaging.cjs",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "audit:all": "npm audit --audit-level=high",
    "build:prebuilt": "node scripts/release-prebuilt/build.cjs",
    "verify:prebuilt": "node scripts/release-prebuilt/verify.cjs",
    "test:prebuilt": "node --test scripts/release-prebuilt/tests/*.check.cjs",
    "test:prebuilt-output": "node scripts/release-prebuilt/test-output.cjs",
    "compare:prebuilt": "node scripts/release-prebuilt/compare.cjs",
    "test:release-cutover": "node --test scripts/release-cutover/*.check.mjs",
    "test:first-cutover": "node --test scripts/first-cutover/policy.check.mjs scripts/first-cutover/backup-recovery.check.mjs",
    "test:first-cutover:emulator": "node --test scripts/first-cutover/emulator.check.mjs",
    "install:controlled": "node scripts/braces-remediation/install.cjs",
    "check:braces": "node scripts/braces-remediation/control.cjs verify",
    "predev": "node scripts/braces-remediation/control.cjs verify",
    "prebuild": "node scripts/braces-remediation/control.cjs verify",
    "precheck:edge-tooling": "node scripts/braces-remediation/control.cjs verify",
    "pretest:edge-tooling": "node scripts/braces-remediation/control.cjs verify",
    "prelint": "node scripts/braces-remediation/control.cjs verify",
    "predev:ts-node": "node scripts/braces-remediation/control.cjs verify",
    "pretest": "node scripts/braces-remediation/control.cjs verify",
    "pretest:watch": "node scripts/braces-remediation/control.cjs verify",
    "pretest:ui": "node scripts/braces-remediation/control.cjs verify",
    "pretest:e2e": "node scripts/braces-remediation/control.cjs verify",
    "pretest:e2e:ui": "node scripts/braces-remediation/control.cjs verify",
    "pretest:e2e:codegen": "node scripts/braces-remediation/control.cjs verify",
    "pretest:catalog:run": "node scripts/braces-remediation/control.cjs verify",
    "pretest:catalog": "node scripts/braces-remediation/control.cjs verify",
    "pretypecheck:api": "node scripts/braces-remediation/control.cjs verify",
    "pretest:catalog:browser": "node scripts/braces-remediation/control.cjs verify",
    "precheck:checkout-packaging": "node scripts/braces-remediation/control.cjs verify",
    "prebuild:prebuilt": "node scripts/braces-remediation/control.cjs verify",
    "pretest:prebuilt": "node scripts/braces-remediation/control.cjs verify",
    "pretest:prebuilt-output": "node scripts/braces-remediation/control.cjs verify",
    "pretest:release-cutover": "node scripts/braces-remediation/control.cjs verify",
    "pretest:first-cutover": "node scripts/braces-remediation/control.cjs verify",
    "pretest:first-cutover:emulator": "node scripts/braces-remediation/control.cjs verify",
    "test:braces": "node --test scripts/braces-remediation/*.check.cjs",
    "pretest:braces": "node scripts/braces-remediation/control.cjs verify",
    "test:release-gate": "node --test scripts/release-gate/*.check.cjs",
    "release:verify": "node scripts/release-gate/cli.cjs verify-pair",
    "release:publication-check": "node scripts/release-gate/cli.cjs publication-check"
  },
  "dependencies": {
