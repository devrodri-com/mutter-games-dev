    "@types/crypto-js": "^4.2.2",
    "@types/express": "^4.17.23",
    "@types/google.maps": "^3.58.1",
    "@types/node": "^20.11.25",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
