// Firestore rules
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers ----
    // Firebase request.auth is the authority; client fields cannot choose a provider.
    function isAuthed() {
      return request.auth != null
        && 'firebase' in request.auth.token && request.auth.token.firebase is map
        && 'sign_in_provider' in request.auth.token.firebase
        && request.auth.token.firebase.sign_in_provider in ['password', 'anonymous'];
    }
    function isAdmin() {
      return isAuthed()
    && request.auth.token.firebase.sign_in_provider == 'password'
    && request.auth.token.email != null
    && exists(/databases/$(database)/documents/adminUsers/$(request.auth.token.email));
}

    // ---- catálogo público ----
    match /products/{id} {
      allow read: if true;
      // Catalogue mutations are server-owned: preserve reservation-aware Admin guards.
      allow create, update, delete: if false;
    }
    match /categories/{id} {
      allow read: if true;
      allow create, update, delete: if false;
    }
    match /categories/{id}/subcategories/{sid} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // ---- carrito (doc id = UID) ----
    match /carts/{cartId} {
      allow read, write: if isAuthed() && request.auth.uid == cartId;
    }

    // ---- órdenes ----
match /orders/{orderId} {
  // R1B candidate, NOT DEPLOYED: commercial records are server-owned.
  allow create: if false;

  // leer: dueño o admin
  allow read: if isAuthed() && (
    resource.data.uid == request.auth.uid || isAdmin()
  );

  // actualizar: (si no lo usás, lo dejamos cerrado)
  allow update: if false;

  // R1B: no browser may remove the durable commercial record.
  allow delete: if false;
}

    // Real R1 private intent path; Admin SDK handlers bypass client Rules.
    match /checkoutIntents/{intentId} { allow read, write: if false; }

    // ---- adminUsers (para validar admin) ----
    match /adminUsers/{id} {
  allow read: if isAuthed();   // o if isAdmin() → tu panel lo usa para traer la lista
  allow write: if false;       // nadie escribe desde front — solo backend o consola
}

    // ---- clients (para el panel “Clientes”) ----
    match /clients/{id} {
      // crear su ficha si el id es su UID o su EMAIL
      allow create: if isAuthed() && (
        id == request.auth.uid ||
        (request.auth.token.email != null && id == request.auth.token.email)
      );

      // leer/actualizar: el dueño o cualquier admin
      allow read, update: if isAuthed() && (
        isAdmin() ||
        id == request.auth.uid ||
        (request.auth.token.email != null && id == request.auth.token.email)
      );

      // borrar: solo admin
      allow delete: if isAdmin();
    }

    // ---- usuarios (legacy) ----
    match /usuarios/{uid} {
      allow read, write: if isAuthed() && request.auth.uid == uid;
    }

    // ---- bloqueo por defecto ----
    match /{document=**} { allow read, write: if false; }
  }
}