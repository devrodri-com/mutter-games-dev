# Firebase client configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Admin API
# Production frontend deployments should use:
# VITE_ADMIN_API_URL=https://mutter-games-admin-api-prod.vercel.app
#
# The legacy dev/staging Admin API is:
# VITE_ADMIN_API_URL=https://mutter-games-admin-api.vercel.app
#
# Local development can point to a local Admin API when one is running:
# VITE_ADMIN_API_URL=http://localhost:3000
VITE_ADMIN_API_URL=

# Optional public client-side integrations
VITE_GOOGLE_MAPS_API_KEY=
VITE_IMAGEKIT_URL_ENDPOINT=
VITE_MP_PUBLIC_KEY=

# Server-only values used by Vercel/API routes. Do not expose these with VITE_.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
